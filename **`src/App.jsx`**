
import React, { useState, useEffect } from 'react';
import Preloader from './components/Preloader';
const App = () => {
  const [loading, setLoading] = useState(true);
  useEffect(() => {
    // Simulate loading delay
    setTimeout(() => {
      setLoading(false);
    }, 2000); 
  }, []);
  return (
    <div>
      {loading && <Preloader />}
      {/* Rest of your app content */}
      {!loading && <p>App Content Loaded</p>} 
    </div>
  );
};
export default App;