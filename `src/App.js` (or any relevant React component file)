
import React, { useState, useEffect } from 'react';
import Preloader from './Preloader';
const App = () => {
  const [isLoading, setIsLoading] = useState(true);
  useEffect(() => {
    // Simulate an asynchronous operation
    setTimeout(() => {
      setIsLoading(false);
    }, 2000);
  }, []);
  return (
    <div>
      {isLoading ? (
        <Preloader />
      ) : (
        <div>
          {/* Main content goes here */}
        </div>
      )}
    </div>
  );
};
export default App;