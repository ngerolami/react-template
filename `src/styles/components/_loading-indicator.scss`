
.loading-indicator {
  display: flex;
  justify-content: center;
  align-items: center;
  .loading-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #333;
    margin: 0 5px;
    animation: loading-dot-animation 1s infinite;
    &.dot-1 {
      animation-delay: 0s;
    }
    &.dot-2 {
      animation-delay: 0.3s;
    }
    &.dot-3 {
      animation-delay: 0.6s;
    }
  }
  @keyframes loading-dot-animation {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.5);
    }
    100% {
      transform: scale(1);
    }
  }
}