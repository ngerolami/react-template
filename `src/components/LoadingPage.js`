
import React, { useState, useEffect } from 'react';
import Preloader from './Preloader';
const LoadingPage = () => {
  const [loading, setLoading] = useState(true);
  useEffect(() => {
    // Simulate loading delay
    setTimeout(() => {
      setLoading(false);
    }, 2000);
  }, []);
  return (
    <div>
      {loading ? <Preloader /> : <h1>Content Loaded!</h1>}
    </div>
  );
};

export default LoadingPage;