
import React from 'react';
import Loader from 'react-loader-spinner';
const LoadingIndicator = ({ type, color, height, width }) => (
  <Loader
    type={type}
    color={color}
    height={height}
    width={width}
  />
);
LoadingIndicator.defaultProps = {
  type: 'Oval',
  color: '#000000',
  height: 80,
  width: 80,
};
export default LoadingIndicator;