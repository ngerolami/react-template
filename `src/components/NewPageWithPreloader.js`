
import React, { useState, useEffect } from 'react';
const NewPageWithPreloader = () => {
  const [isLoading, setIsLoading] = useState(true);
  useEffect(() => {
    // Simulate loading data or performing an asynchronous operation
    const timeout = setTimeout(() => {
      setIsLoading(false);
    }, 2000);
    return () => clearTimeout(timeout);
  }, []);
  return (
    <div>
      {isLoading ? (
        <div>Loading...</div>
      ) : (
        <div>
          <h1>New Page with Preloader</h1>
          <p>This is the content of the new page.</p>
        </div>
      )}
    </div>
  );
};
export default NewPageWithPreloader;