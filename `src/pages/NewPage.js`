
import React, { useState, useEffect } from 'react';
const NewPage = () => {
  const [isLoading, setIsLoading] = useState(true);
  useEffect(() => {
    // Simulate a delay to display the pre-loader
    const timer = setTimeout(() => {
      setIsLoading(false);
    }, 2000);
    return () => clearTimeout(timer);
  }, []);
  return (
    <div>
      {isLoading ? (
        <div>Loading...</div>
      ) : (
        <div>
          <h1>New Page</h1>
          <p>This is the new page with a pre-loader.</p>
        </div>
      )}
    </div>
  );
};
export default NewPage;