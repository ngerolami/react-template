
/* src/styles.css */
#preloader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #fff; /* Example background color */
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999; /* Ensure preloader is on top */
}
#content { /* Basic styling for the content area */
  padding: 20px;
}